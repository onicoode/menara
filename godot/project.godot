; Menara Rongsok (versi Godot) - Godot 4.4
config_version=5

[application]
config/name="Menara Rongsok"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]
Balance="*res://scripts/balance.gd"
D="*res://scripts/data.gd"
Dev="*res://scripts/dev.gd"
Prof="*res://scripts/prof.gd"

[display]
window/size/viewport_width=390
window/size/viewport_height=780
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
